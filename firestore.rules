rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCatalogItem(data) {
      return data.keys().hasAll(['name', 'category', 'unitPrice'])
        && data.keys().hasOnly(['name', 'category', 'unitPrice'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.unitPrice is number && data.unitPrice >= 0;
    }

    function isValidSavedGift(data) {
      return data.keys().hasAll(['title', 'createdAt', 'items', 'laborCost', 'totalCost'])
        && data.keys().hasOnly(['title', 'createdAt', 'items', 'laborCost', 'totalCost'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 150
        && data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 60
        && data.items is list && data.items.size() <= 200
        && data.laborCost is number && data.laborCost >= 0
        && data.totalCost is number && data.totalCost >= 0;
    }

    match /catalog/{itemId} {
      allow list, get: if true;
      allow create: if isValidId(itemId) && isValidCatalogItem(incoming());
      allow update: if isValidId(itemId)
        && isValidCatalogItem(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'unitPrice']);
      allow delete: if isValidId(itemId);
    }

    match /savedGifts/{giftId} {
      allow list, get: if true;
      allow create: if isValidId(giftId) && isValidSavedGift(incoming());
      allow update: if isValidId(giftId)
        && isValidSavedGift(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'items', 'laborCost', 'totalCost']);
      allow delete: if isValidId(giftId);
    }
  }
}
