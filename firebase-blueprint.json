{
  "entities": {
    "CatalogItem": {
      "title": "CatalogItem",
      "description": "A dulce, material, fruta, pastel, jugo, desayuno, or custom item in the shared catalog.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name of the product",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Category of the product",
          "minLength": 1,
          "maxLength": 60
        },
        "unitPrice": {
          "type": "number",
          "description": "Unit price in COP"
        }
      },
      "required": ["name", "category", "unitPrice"]
    },
    "SavedGift": {
      "title": "SavedGift",
      "description": "A saved personalized gift quote with line items and labor cost.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title or customer name for the gift",
          "minLength": 1,
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "description": "Formatted creation date string",
          "minLength": 1,
          "maxLength": 60
        },
        "items": {
          "type": "array",
          "description": "List of gift line items"
        },
        "laborCost": {
          "type": "number",
          "description": "Labor cost in COP"
        },
        "totalCost": {
          "type": "number",
          "description": "Total gift cost in COP"
        }
      },
      "required": ["title", "createdAt", "items", "laborCost", "totalCost"]
    }
  },
  "firestore": {
    "/catalog/{itemId}": {
      "schema": { "$ref": "#/entities/CatalogItem" },
      "description": "Shared real-time catalog of products accessible from any device via link"
    },
    "/savedGifts/{giftId}": {
      "schema": { "$ref": "#/entities/SavedGift" },
      "description": "Shared real-time saved gifts accessible from any device via link"
    }
  }
}
